# Скопируйте файл в .env и добавьте токен бота MAX локально.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_POLLING_TIMEOUT=30
MAX_REQUEST_TIMEOUT=40
DATABASE_URL=postgresql://max_user:change_me@postgres:5432/max_app
POSTGRES_DB=max_app
POSTGRES_USER=max_user
POSTGRES_PASSWORD=change_me
# Управляющая компания по умолчанию (справочник домов заполняет её администратор).
ORG_NAME=Тестовая УК «Демо»
# MAX user_id через запятую (свой id покажет команда /myid в боте).
# Администраторы УК: справочник домов, сотрудники, QR-плакаты, показатели.
UK_ADMIN_IDS=
# Диспетчеры УК: очередь заявок, сроки, исполнители, объявления.
UK_OPERATOR_IDS=
# Администраторы сервиса: подключают новые УК командой /org_new.
PLATFORM_ADMIN_IDS=
# Только для демо: /uk <код> делает пользователя администратором УК.
UK_ACCESS_CODE=demo-uk-code
# Сколько жители могут подтверждать выполнение (48 ч в пилоте, 10 мин для демо).
CONFIRMATION_TIMEOUT_MINUTES=2880
# При запуске добавить тестовые данные (УК, 4 дома, 13 заявок). Повторно не дублируются.
SEED_DEMO=true
# Ссылка на бота для приглашений и QR. Пусто — возьмём username из GET /me.
MAX_BOT_LINK=
# Часовой пояс для сроков в сообщениях (Москва = 3).
DISPLAY_UTC_OFFSET_HOURS=3
# Куда бот направляет жителя при нарушении сроков (официальный канал обращений).
OFFICIAL_APPEAL_URL=https://dom.gosuslugi.ru
